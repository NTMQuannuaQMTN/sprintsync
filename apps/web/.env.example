# Supabase — Settings > API in the Supabase dashboard.
# The anon key is safe to expose client-side (NEXT_PUBLIC_*); Row Level
# Security on the database is what actually protects data, not secrecy of
# this key. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
