{
  "name": "@sprintsync/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "dev": ".venv/bin/uvicorn src.main:app --reload --port 8000",
    "start": ".venv/bin/uvicorn src.main:app --port 8000",
    "build": ".venv/bin/ruff check src && .venv/bin/mypy src",
    "lint": ".venv/bin/ruff check src",
    "test": ".venv/bin/pytest"
  }
}
