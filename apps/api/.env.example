# Database — your Supabase project's Postgres connection string.
# Supabase dashboard: Settings > Database > Connection string (use the
# "Transaction" pooler string or a direct connection; either works with
# asyncpg). This app connects with the service_role-equivalent DB user, so
# its own queries bypass Row Level Security by design.
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# GitHub Webhook — a secret you choose yourself when configuring the
# webhook on the GitHub repo/app side. Empty disables signature
# verification (dev-mode only).
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Supabase — GitHub OAuth itself is configured in the Supabase dashboard
# under Authentication > Providers > GitHub (client id/secret live there,
# not in this app). SUPABASE_JWT_SECRET is under Settings > API > JWT
# Settings > JWT Secret — required to verify the access tokens Supabase
# issues to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_BUCKET=sprintsync-specs

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Environment
ENV=development
